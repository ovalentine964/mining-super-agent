# Sovereign Resource DAO — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(64))"

# ═══════════════════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════════════════

# Environment: "production" or "development"
APP_ENV=production

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Comma-separated allowed origins for CORS (REQUIRED in production, no wildcards)
# Example: https://mining.example.com,https://dashboard.example.com
CORS_ORIGINS=https://mining.example.com

# ═══════════════════════════════════════════════════════════════════════════════
# DOMAIN & TLS (used by Caddy reverse proxy)
# ═══════════════════════════════════════════════════════════════════════════════

# Your domain (Caddy auto-provisions TLS via Let's Encrypt)
DOMAIN=mining.example.com

# Email for ACME/Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# ═══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION & ENCRYPTION (all REQUIRED)
# ═══════════════════════════════════════════════════════════════════════════════

# JWT signing key — Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_secrets

# JWT refresh token key — Must be DIFFERENT from JWT_SECRET_KEY
JWT_REFRESH_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_secrets_different

# API key encryption key — Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEYS_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_fernet

# General encryption key — Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_fernet

# MFA issuer name shown in authenticator apps
MFA_ISSUER_NAME=Sovereign Resource DAO

# ═══════════════════════════════════════════════════════════════════════════════
# POSTGRESQL + POSTGIS
# ═══════════════════════════════════════════════════════════════════════════════

# Database name
POSTGRES_DB=mining

# Database user
POSTGRES_USER=mining

# Database password (REQUIRED — min 20 characters)
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_20_CHARS_MIN

# ═══════════════════════════════════════════════════════════════════════════════
# REDIS (cache, sessions, rate limiting)
# ═══════════════════════════════════════════════════════════════════════════════

# Redis password (REQUIRED — min 20 characters)
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_20_CHARS

# ═══════════════════════════════════════════════════════════════════════════════
# MINIO (S3-compatible object storage)
# ═══════════════════════════════════════════════════════════════════════════════

# MinIO root user (REQUIRED)
MINIO_ROOT_USER=mining_admin

# MinIO root password (REQUIRED — min 20 characters)
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD_20_CHARS

# ═══════════════════════════════════════════════════════════════════════════════
# AI / LLM API KEYS (optional — enables specific capabilities)
# ═══════════════════════════════════════════════════════════════════════════════

# NVIDIA NIM — voice transcription, vision models
NVIDIA_API_KEY=

# Groq — fast LLM inference
GROQ_API_KEY=

# Google AI (Gemini)
GOOGLE_AI_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# TELEGRAM BOT
# ═══════════════════════════════════════════════════════════════════════════════

# Telegram Bot Token — get from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram webhook URL (optional — for production webhook mode)
TELEGRAM_WEBHOOK_URL=

# Backend URL for Telegram bot API calls (default: http://localhost:8000)
BACKEND_URL=http://app:8000

# ═══════════════════════════════════════════════════════════════════════════════
# SATELLITE DATA (Copernicus / Sentinel-2)
# ═══════════════════════════════════════════════════════════════════════════════

COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# MARKET DATA PROVIDERS
# ═══════════════════════════════════════════════════════════════════════════════

# Finnhub — commodity/stock prices (fallback provider)
FINNHUB_API_KEY=

# Alpha Vantage — commodity prices (fallback provider)
ALPHA_VANTAGE_API_KEY=

# EIA — US Energy Information Administration
EIA_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# BLOCKCHAIN / ORACLE (Polygon)
# ═══════════════════════════════════════════════════════════════════════════════

# Polygon RPC endpoint (Alchemy/Infura/QuickNode)
POLYGON_RPC_URL=https://polygon-rpc.com

# Oracle wallet private key (for on-chain submissions)
ORACLE_PRIVATE_KEY=

# MiningOracle.sol deployed address
MINING_ORACLE_ADDRESS=

# ExtractionTracker.sol deployed address
EXTRACTION_TRACKER_ADDRESS=

# Chain ID: 137 (Polygon mainnet) or 80001 (Mumbai testnet)
CHAIN_ID=137

# ═══════════════════════════════════════════════════════════════════════════════
# BACKUP (optional — S3-compatible offsite backups)
# ═══════════════════════════════════════════════════════════════════════════════

BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_KMS_KEY_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# API KEY AUTH (optional — protect API endpoints)
# ═══════════════════════════════════════════════════════════════════════════════

# If set, all API requests must include X-API-Key header
API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# RUST GATEWAY (optional — high-performance API layer)
# ═══════════════════════════════════════════════════════════════════════════════

# Gateway port inside container
GATEWAY_PORT=8080

# Tools YAML config path
TOOLS_CONFIG_PATH=config/tools.yaml

# Rate limiting
DEFAULT_RATE_LIMIT=100
RATE_WINDOW_SECS=60
