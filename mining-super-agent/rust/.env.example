# Mining Super Agent — Rust API Gateway
# Copy to .env and fill in values

# Server
HOST=0.0.0.0
PORT=8080

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgres://mining:password@postgres:5432/mining_db

# Redis
REDIS_URL=redis://redis:6379

# JWT (min 32 chars)
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Tools config
TOOLS_CONFIG_PATH=config/tools.yaml

# Python AI/ML Services
DEERFLOW_URL=http://deerflow:8000
GEOLOGICAL_SERVICE_URL=http://geological:8001
SATELLITE_SERVICE_URL=http://satellite:8002
VISION_SERVICE_URL=http://vision:8003
QUANTUM_SERVICE_URL=http://quantum:8004

# External API Keys
FINNHUB_API_KEY=
EIA_API_KEY=

# Rate Limiting
DEFAULT_RATE_LIMIT=100
RATE_WINDOW_SECS=60
