# Mining Super-Agent — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.

APP_ENV=production
LOG_LEVEL=INFO
DOMAIN=mining.example.com
ACME_EMAIL=admin@example.com
CORS_ORIGINS=https://mining.example.com

# JWT — Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_secrets
JWT_REFRESH_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_secrets_different

# API Key Encryption — Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEYS_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_fernet

# PostgreSQL
POSTGRES_DB=mining
POSTGRES_USER=mining
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_20_CHARS_MIN

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_20_CHARS

# MinIO
MINIO_ROOT_USER=mining_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD_20_CHARS

# AI APIs
NVIDIA_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=

# Satellite
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Market Data
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Backup (optional)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_KMS_KEY_ID=
