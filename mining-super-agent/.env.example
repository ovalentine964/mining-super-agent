# Mining Super-Agent — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.

# ─── Application ────────────────────────────────────────────────
# Environment: development | staging | production
APP_ENV=production
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Domain & TLS ───────────────────────────────────────────────
# Your domain (Caddy auto-provisions Let's Encrypt cert)
DOMAIN=mining.example.com
# Email for Let's Encrypt notifications
ACME_EMAIL=admin@example.com

# ─── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins (NO wildcards)
# Example: https://mining.example.com,https://app.mining.example.com
CORS_ORIGINS=https://mining.example.com

# ─── JWT Authentication ─────────────────────────────────────────
# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app REFUSES TO START if these are not set
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_secrets
JWT_REFRESH_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_secrets_different

# ─── API Key Encryption ────────────────────────────────────────
# Used to encrypt stored API keys (Fernet encryption)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEYS_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_fernet

# ─── PostgreSQL ─────────────────────────────────────────────────
# Database name and user (password is required)
POSTGRES_DB=mining
POSTGRES_USER=mining
# CRITICAL: Strong password, minimum 20 characters
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_20_CHARS_MIN

# ─── Redis ──────────────────────────────────────────────────────
# CRITICAL: Strong password, minimum 20 characters
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_20_CHARS

# ─── MinIO (S3-compatible storage) ─────────────────────────────
MINIO_ROOT_USER=mining_admin
# CRITICAL: Strong password, minimum 20 characters
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD_20_CHARS

# ─── External AI APIs ──────────────────────────────────────────
# NVIDIA NIM (primary LLM provider) — get from build.nvidia.com
NVIDIA_API_KEY=
# Groq (fallback LLM) — get from console.groq.com
GROQ_API_KEY=
# Google AI Studio (fallback) — get from aistudio.google.com
GOOGLE_AI_API_KEY=
# Together AI (fallback) — get from api.together.xyz
TOGETHER_API_KEY=
# Mistral (fallback) — get from console.mistral.ai
MISTRAL_API_KEY=

# ─── Telegram Bot ──────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ─── S3 Backup (optional, for automated backups) ──────────────
# AWS-compatible S3 for encrypted backups
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_ENDPOINT=
# KMS key ARN for backup encryption
BACKUP_KMS_KEY_ID=

# ─── Sentinelinel-2 / Satellite ────────────────────────────────
# Copernicus Data Space — get from dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ─── Market Data ───────────────────────────────────────────────
# Finnhub (free tier) — get from finnhub.io
FINNHUB_API_KEY=
# Alpha Vantage (free tier) — get from alphavantage.co
ALPHA_VANTAGE_API_KEY=
